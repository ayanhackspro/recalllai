# ---------------------------------------------------------------------------
# RecallAI API configuration
#
# Copy to .env and fill in. Nothing here is ever sent to the browser:
# the frontend only ever sees NEXT_PUBLIC_API_URL.
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=4000

# Postgres connection string.
#
#   Neon (recommended): the pooled connection string from the Neon console.
#   Local:              postgresql://postgres:postgres@localhost:5432/recallai
#
# Leave empty to run against the in-memory store. History will not survive a
# restart, but every route behaves the same — useful before you provision a DB.
DATABASE_URL=

# Origins allowed to call the API from a browser, comma separated.
# Leave unset during development to reflect any localhost origin, whichever
# port the web app is on. Required in production.
CORS_ORIGIN=

# Where uploaded files are written. Created on boot if missing.
UPLOAD_DIR=./uploads

# Max upload size in bytes. The UI enforces the same per-type limits; this is
# the server-side backstop and must never be looser.
MAX_UPLOAD_BYTES=20971520

# Set to "1" to accept uploads larger than the allowlist per-type limits.
# Off by default so the browser's validation is not silently bypassed.
ALLOW_OVERSIZE=false

# Pause in milliseconds between streamed chunks. Raise it when demoing so the
# typing effect is visible. 0 streams as fast as the socket allows.
STREAM_CHUNK_DELAY_MS=28

# Log each request line to stdout.
LOG_REQUESTS=true